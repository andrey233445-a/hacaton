# MAX bot token (required to start the bot)
BOT_TOKEN=your-max-bot-token

# Web admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Fernet key for class password encryption
CLASS_PASSWORD_KEY=

# PostgreSQL credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hq_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=school_hq_db
# Для Docker-развертывания хост БД — db (имя сервиса в Compose-сети).
# Если DATABASE_URL не задан, он собирается из переменных выше.
DATABASE_URL=postgresql+asyncpg://hq_user:change_me@db:5432/school_hq_db

# AI-психолог (OpenAI-совместимый API, модель Kimi K3)
AI_PSYCHOLOGIST_BASE_URL=https://api.plakcel.xyz/v1
AI_PSYCHOLOGIST_API_KEY=
AI_PSYCHOLOGIST_MODEL=kimi-k3

# Публичный URL мини веб-приложения (веб-процесс uvicorn app.admin_web).
# Локально: http://127.0.0.1:8000, на сервере — внешний адрес (https://...).
MINI_APP_URL=http://127.0.0.1:8000

# Username бота для нативной кнопки мини-приложения MAX (тип open_app).
# Пусто — бот определит его сам через GET /me; если не получится, кнопка
# «🕹 Открыть мини-приложение» останется обычной ссылкой.
MINI_APP_BOT_NAME=

# Скрытая dev-панель команды: MAX ID разработчиков через запятую и команда панели.
# Пусто — панель недоступна никому. Свои ID можно посмотреть в БД:
# SELECT max_user_id, full_name, role FROM users;
DEV_MAX_IDS=
DEV_COMMAND=/dev
